+    PokegearManagedObject *partner = &mapApp->objManager->objects[PGMAP_SPRITE_PARTNER];
+
+    // autoCull is cleared whenever the icon is hidden (see ov101_021EA238)
+    if (!mapApp->partnerShown || mapApp->type != PGMAP_TYPE_GEAR || !partner->autoCull) {
+        return;
