diff --git a/config.mk b/config.mk
index 2b5ff9e..187e7c4 100644
--- a/config.mk
+++ b/config.mk
@@ -44,10 +44,15 @@ DEFINES = $(GF_DEFINES) $(GLB_DEFINES) $(CLI_DEFINES)
 # Secure CRC
 ifeq ($(buildname),heartgold.us)
 SECURE_CRC := 0xA0FF
+USRCHEAT_KEY := 0x4DFFBF91
 endif
 ifeq ($(buildname),soulsilver.us)
 SECURE_CRC := 0x86A5
+USRCHEAT_KEY := 0x2D5118CA
 endif
+# Co-op mod: USRCHEAT_KEY is the retail ROM's usrcheat.dat key (the CRC32 of
+# its 512-byte header). The ROM header is set to match it, so cheat loaders
+# offer the retail cheats (see tools/usrcheat_crc/usrcheat_crc.py).
 
 ifndef SECURE_CRC
 $(error Unsupported ROM: $(GAME_VERSION) $(GAME_LANGUAGE))
diff --git a/files/fielddata/script/scr_seq/scr_seq_0003.s b/files/fielddata/script/scr_seq/scr_seq_0003.s
index e10d60e..89ece7e 100644
--- a/files/fielddata/script/scr_seq/scr_seq_0003.s
+++ b/files/fielddata/script/scr_seq/scr_seq_0003.s
@@ -1,4 +1,5 @@
 #include "constants/scrcmd.h"
+#include "constants/coop.h"
 #include "fielddata/script/scr_seq/event_0003.h"
 #include "msgdata/msg/msg_0040.h"
 #include "msgdata/msg/msg_0191.h"
@@ -78,6 +79,8 @@
 	ScrDef scr_seq_0003_069
 	ScrDef scr_seq_0003_070
 	ScrDef scr_seq_0003_071
+	ScrDef scr_seq_0003_072
+	ScrDef scr_seq_0003_073
 	ScrDefEnd
 
 scr_seq_0003_002:
@@ -1751,4 +1754,599 @@ scr_seq_0003_064:
 	CloseMsg
 	ReleaseAll
 	End
+
+; ---------------------------------------------------------------------------
+; Co-op mod
+; ---------------------------------------------------------------------------
+; Vars: x8004 = COOP_REQ_* of the request being made/answered,
+;       x8005/x8006 = subroutine inputs, x8007 = scratch.
+
+; std_coop_menu: talked to the linked partner (or their Pokémon)
+scr_seq_0003_072:
+	PlaySE SEQ_SE_DP_SELECT
+	LockAll
+	Coop COOP_SUB_BUFFER_PARTNER, 0, VAR_SPECIAL_RESULT
+	Compare VAR_SPECIAL_RESULT, 0
+	GoToIfEq _coop_release
+	NonNPCMsg msg_0040_00117
+	; MenuInit/MenuExec draw on the bottom screen and require it
+	; (MenuExec asserts otherwise). Restored in _coop_release.
+	TouchscreenMenuHide
+	MenuInit 1, 1, 0, 1, VAR_SPECIAL_RESULT
+	MenuItemAdd msg_0040_00118, 255, 0
+	MenuItemAdd msg_0040_00119, 255, 1
+	MenuItemAdd msg_0040_00120, 255, 2
+	MenuItemAdd msg_0040_00121, 255, 3
+	MenuExec
+	Switch VAR_SPECIAL_RESULT
+	Case 0, _coop_battle
+	Case 1, _coop_trade
+	Case 2, _coop_card
+	GoTo _coop_close
+
+; --- Battle ------------------------------------------------------------------
+
+_coop_battle:
+	SetVar VAR_SPECIAL_x8004, COOP_REQ_BATTLE
+	GoTo _coop_send
+
+; --- Trade -------------------------------------------------------------------
+
+_coop_trade:
+	NonNPCMsg msg_0040_00122
+	MenuInit 1, 1, 0, 1, VAR_SPECIAL_RESULT
+	MenuItemAdd msg_0040_00123, 255, 0
+	MenuItemAdd msg_0040_00124, 255, 1
+	MenuItemAdd msg_0040_00125, 255, 2
+	MenuItemAdd msg_0040_00168, 255, 3
+	MenuItemAdd msg_0040_00169, 255, 4
+	MenuItemAdd msg_0040_00121, 255, 5
+	MenuExec
+	Switch VAR_SPECIAL_RESULT
+	Case 0, _coop_trade_mon
+	Case 1, _coop_trade_item
+	Case 2, _coop_trade_money
+	Case 3, _coop_sell
+	Case 4, _coop_buy
+	GoTo _coop_close
+
+_coop_trade_mon:
+	SetVar VAR_SPECIAL_x8004, COOP_REQ_TRADE
+	GoTo _coop_send
+
+_coop_trade_item:
+	SetVar VAR_SPECIAL_x8006, msg_0040_00126
+	Call _coop_pick_item
+	Compare VAR_SPECIAL_RESULT, 0
+	GoToIfEq _coop_release
+	SetVar VAR_SPECIAL_x8004, COOP_REQ_ITEM
+	GoTo _coop_send
+
+_coop_trade_money:
+	SetVar VAR_SPECIAL_x8005, COOP_AMOUNT_WALLET
+	SetVar VAR_SPECIAL_x8006, msg_0040_00187
+	Call _coop_choose_amount
+	Compare VAR_SPECIAL_RESULT, 0
+	GoToIfEq _coop_close
+	SetVar VAR_SPECIAL_x8004, COOP_REQ_MONEY
+	GoTo _coop_send
+
+; Sell: we pick the goods and the price, the partner decides whether to buy.
+_coop_sell:
+	NonNPCMsg msg_0040_00170
+	MenuInit 1, 1, 0, 1, VAR_SPECIAL_RESULT
+	MenuItemAdd msg_0040_00124, 255, 0
+	MenuItemAdd msg_0040_00123, 255, 1
+	MenuItemAdd msg_0040_00121, 255, 2
+	MenuExec
+	Switch VAR_SPECIAL_RESULT
+	Case 0, _coop_sell_item
+	Case 1, _coop_sell_mon
+	GoTo _coop_close
+
+_coop_sell_item:
+	SetVar VAR_SPECIAL_x8006, msg_0040_00172
+	Call _coop_pick_item
+	Compare VAR_SPECIAL_RESULT, 0
+	GoToIfEq _coop_release
+	SetVar VAR_SPECIAL_x8004, COOP_REQ_SELL_ITEM
+	GoTo _coop_sell_price
+
+_coop_sell_mon:
+	Call _coop_pick_mon
+	Compare VAR_SPECIAL_RESULT, COOP_MON_OK
+	GoToIfNe _coop_release
+	SetVar VAR_SPECIAL_x8004, COOP_REQ_SELL_MON
+_coop_sell_price:
+	SetVar VAR_SPECIAL_x8005, COOP_AMOUNT_PRICE
+	SetVar VAR_SPECIAL_x8006, msg_0040_00173
+	Call _coop_choose_amount
+	Compare VAR_SPECIAL_RESULT, 0
+	GoToIfEq _coop_close
+	GoTo _coop_send
+
+; Buy: we name the price, the partner picks what to sell us, we confirm.
+_coop_buy:
+	NonNPCMsg msg_0040_00171
+	MenuInit 1, 1, 0, 1, VAR_SPECIAL_RESULT
+	MenuItemAdd msg_0040_00124, 255, 0
+	MenuItemAdd msg_0040_00123, 255, 1
+	MenuItemAdd msg_0040_00121, 255, 2
+	MenuExec
+	Switch VAR_SPECIAL_RESULT
+	Case 0, _coop_buy_item
+	Case 1, _coop_buy_mon
+	GoTo _coop_close
+
+_coop_buy_item:
+	SetVar VAR_SPECIAL_x8004, COOP_REQ_BUY_ITEM
+	GoTo _coop_buy_price
+
+_coop_buy_mon:
+	SetVar VAR_SPECIAL_x8004, COOP_REQ_BUY_MON
+_coop_buy_price:
+	SetVar VAR_SPECIAL_x8005, COOP_AMOUNT_WALLET
+	SetVar VAR_SPECIAL_x8006, msg_0040_00174
+	Call _coop_choose_amount
+	Compare VAR_SPECIAL_RESULT, 0
+	GoToIfEq _coop_close
+	GoTo _coop_send
+
+; --- Trainer Card ------------------------------------------------------------
+
+_coop_card:
+	Coop COOP_SUB_REQUEST, COOP_REQ_CARD, VAR_SPECIAL_RESULT
+	Compare VAR_SPECIAL_RESULT, 0
+	GoToIfEq _coop_link_lost
+	NonNPCMsg msg_0040_00155
+	Coop COOP_SUB_WAIT_CARD, 0, VAR_SPECIAL_RESULT
+	Compare VAR_SPECIAL_RESULT, 0
+	GoToIfEq _coop_card_fail
+	FadeScreen 6, 1, 0, RGB_BLACK
+	WaitFade
+	CloseMsg
+	Coop COOP_SUB_SHOW_CARD, 0, VAR_SPECIAL_RESULT
+	RestoreOverworld
+	FadeScreen 6, 1, 1, RGB_BLACK
+	WaitFade
+	GoTo _coop_release
+
+_coop_card_fail:
+	NonNPCMsg msg_0040_00156
+	WaitABPress
+	GoTo _coop_close
+
+; --- Sending a request -------------------------------------------------------
+
+; VAR_SPECIAL_x8004 = COOP_REQ_*
+_coop_send:
+	Coop COOP_SUB_REQUEST, VAR_SPECIAL_x8004, VAR_SPECIAL_RESULT
+	Compare VAR_SPECIAL_RESULT, 0
+	GoToIfEq _coop_link_lost
+	NonNPCMsg msg_0040_00137
+	Coop COOP_SUB_WAIT_RESPONSE, 0, VAR_SPECIAL_RESULT
+	Switch VAR_SPECIAL_RESULT
+	Case COOP_RESULT_ACCEPT, _coop_accepted
+	Case COOP_RESULT_OFFER, _coop_offer
+	Case COOP_RESULT_DECLINE, _coop_declined
+	Case COOP_RESULT_BUSY, _coop_busy
+	Case COOP_RESULT_FULL, _coop_full
+	Case COOP_RESULT_POOR, _coop_poor
+	Case COOP_RESULT_CANCELLED, _coop_close
+	GoTo _coop_no_answer
+
+_coop_accepted:
+	Switch VAR_SPECIAL_x8004
+	Case COOP_REQ_ITEM, _coop_sent_item
+	Case COOP_REQ_MONEY, _coop_sent_money
+	Case COOP_REQ_SELL_ITEM, _coop_sold_item
+	Case COOP_REQ_SELL_MON, _coop_sold_mon
+	GoTo _coop_activity
+
+_coop_sent_item:
+	NonNPCMsg msg_0040_00146
+	WaitABPress
+	GoTo _coop_close
+
+_coop_sent_money:
+	NonNPCMsg msg_0040_00147
+	WaitABPress
+	GoTo _coop_close
+
+_coop_sold_item:
+	PlaySE SEQ_SE_DP_REGI
+	NonNPCMsg msg_0040_00179
+	WaitABPress
+	GoTo _coop_close
+
+_coop_sold_mon:
+	PlaySE SEQ_SE_DP_REGI
+	NonNPCMsg msg_0040_00180
+	WaitABPress
+	CloseMsg
+	; Our party changed: reload the overworld so the walking Pokémon matches.
+	FadeScreen 6, 1, 0, RGB_BLACK
+	WaitFade
+	Coop COOP_SUB_LEAVE_FIELD, 0, VAR_SPECIAL_RESULT
+	RestoreOverworld
+	FadeScreen 6, 1, 1, RGB_BLACK
+	WaitFade
+	GoTo _coop_release
+
+; The partner picked goods for our Buy request.
+_coop_offer:
+	Compare VAR_SPECIAL_x8004, COOP_REQ_BUY_MON
+	GoToIfEq _coop_offer_mon
+	NonNPCMsg msg_0040_00175
+	GoTo _coop_offer_ask
+
+_coop_offer_mon:
+	NonNPCMsg msg_0040_00176
+_coop_offer_ask:
+	YesNo VAR_SPECIAL_RESULT
+	NonNPCMsg msg_0040_00157
+	Coop COOP_SUB_BUY_CONFIRM, VAR_SPECIAL_RESULT, VAR_SPECIAL_RESULT
+	Switch VAR_SPECIAL_RESULT
+	Case COOP_RESULT_ACCEPT, _coop_bought
+	Case COOP_RESULT_DECLINE, _coop_close
+	Case COOP_RESULT_FULL, _coop_no_room
+	Case COOP_RESULT_POOR, _coop_not_enough
+	GoTo _coop_link_lost
+
+_coop_bought:
+	Coop COOP_SUB_DEAL_INFO, 0, VAR_SPECIAL_x8007
+	Compare VAR_SPECIAL_x8007, COOP_DEAL_ITEM
+	GoToIfEq _coop_bought_item
+	PlayFanfare SEQ_ME_ITEM
+	NonNPCMsg msg_0040_00182
+	WaitFanfare
+	WaitABPress
+	Compare VAR_SPECIAL_x8007, COOP_DEAL_MON
+	GoToIfEq _coop_close
+	NonNPCMsg msg_0040_00183
+	WaitABPress
+	GoTo _coop_close
+
+_coop_bought_item:
+	PlayFanfare SEQ_ME_ITEM
+	NonNPCMsg msg_0040_00181
+	WaitFanfare
+	WaitABPress
+	GoTo _coop_close
+
+_coop_no_room:
+	Coop COOP_SUB_DEAL_INFO, 0, VAR_SPECIAL_x8007
+	Compare VAR_SPECIAL_x8007, COOP_DEAL_ITEM
+	GoToIfEq _coop_bag_full
+	NonNPCMsg msg_0040_00186
+	WaitABPress
+	GoTo _coop_close
+
+_coop_bag_full:
+	NonNPCMsg msg_0040_00152
+	WaitABPress
+	GoTo _coop_close
+
+_coop_not_enough:
+	NonNPCMsg msg_0040_00150
+	WaitABPress
+	GoTo _coop_close
+
+_coop_declined:
+	NonNPCMsg msg_0040_00138
+	WaitABPress
+	GoTo _coop_close
+
+_coop_busy:
+	NonNPCMsg msg_0040_00139
+	WaitABPress
+	GoTo _coop_close
+
+_coop_full:
+	NonNPCMsg msg_0040_00140
+	WaitABPress
+	GoTo _coop_close
+
+_coop_poor:
+	NonNPCMsg msg_0040_00164
+	WaitABPress
+	GoTo _coop_close
+
+_coop_no_answer:
+	NonNPCMsg msg_0040_00141
+	WaitABPress
+	GoTo _coop_close
+
+_coop_canceled:
+	NonNPCMsg msg_0040_00188
+	WaitABPress
+	GoTo _coop_close
+
+_coop_link_lost:
+	NonNPCMsg msg_0040_00154
+	WaitABPress
+	GoTo _coop_close
+
+; --- Battle / Pokémon trade (both players) -------------------------------------
+
+; Both players run this once a battle/trade request was accepted.
+; VAR_SPECIAL_x8004 = COOP_REQ_BATTLE or COOP_REQ_TRADE
+_coop_activity:
+	NonNPCMsg msg_0040_00157
+	Coop COOP_SUB_ACTIVITY_SYNC, VAR_SPECIAL_x8004, VAR_SPECIAL_RESULT
+	Compare VAR_SPECIAL_RESULT, 0
+	GoToIfEq _coop_link_lost
+	CloseMsg
+	Compare VAR_SPECIAL_x8004, COOP_REQ_TRADE
+	GoToIfEq _coop_do_trade
+	Coop COOP_SUB_START_BATTLE, 0, VAR_SPECIAL_RESULT
+	GoTo _coop_release
+
+_coop_do_trade:
+	FadeScreen 6, 1, 0, RGB_BLACK
+	WaitFade
+	Coop COOP_SUB_START_TRADE, 0, VAR_SPECIAL_RESULT
+	Coop COOP_SUB_ACTIVITY_END, 0, VAR_SPECIAL_RESULT
+	RestoreOverworld
+	FadeScreen 6, 1, 1, RGB_BLACK
+	WaitFade
+	GoTo _coop_release
+
+_coop_close:
+	CloseMsg
+_coop_release:
+	; no-op if the touch menu was never hidden
+	TouchscreenMenuShow
+	ReleaseAll
+	End
+
+; --- Subroutines -------------------------------------------------------------
+
+; Choose an amount of money: preset or typed in.
+; In:  x8005 = COOP_AMOUNT_*, x8006 = one-line prompt (msg id)
+; Out: VAR_SPECIAL_RESULT = 1 if chosen (the Coop command keeps it), 0 if cancelled.
+;      The message box is left open.
+_coop_choose_amount:
+	Coop COOP_SUB_AMOUNT_MODE, VAR_SPECIAL_x8005, VAR_SPECIAL_RESULT
+	ShowMoneyBox 20, 2
+_coop_choose_amount_menu:
+	NonNPCMsgVar VAR_SPECIAL_x8006
+	MenuInit 1, 1, 0, 1, VAR_SPECIAL_RESULT
+	MenuItemAdd msg_0040_00132, 255, 0
+	MenuItemAdd msg_0040_00134, 255, 2
+	MenuItemAdd msg_0040_00135, 255, 3
+	MenuItemAdd msg_0040_00136, 255, 4
+	MenuItemAdd msg_0040_00162, 255, 5
+	MenuItemAdd msg_0040_00121, 255, 6
+	MenuExec
+	Compare VAR_SPECIAL_RESULT, 5
+	GoToIfEq _coop_choose_amount_custom
+	GoToIfGt _coop_choose_amount_cancel
+	Coop COOP_SUB_SET_AMOUNT, VAR_SPECIAL_RESULT, VAR_SPECIAL_RESULT
+	Compare VAR_SPECIAL_RESULT, 0
+	GoToIfNe _coop_choose_amount_done
+	NonNPCMsg msg_0040_00150
+	WaitABPress
+	GoTo _coop_choose_amount_menu
+
+_coop_choose_amount_custom:
+	Coop COOP_SUB_ENTER_AMOUNT, VAR_SPECIAL_x8006, VAR_SPECIAL_RESULT
+	Compare VAR_SPECIAL_RESULT, 0
+	GoToIfEq _coop_choose_amount_menu
+_coop_choose_amount_done:
+	HideMoneyBox
+	SetVar VAR_SPECIAL_RESULT, 1
+	Return
+
+_coop_choose_amount_cancel:
+	HideMoneyBox
+	SetVar VAR_SPECIAL_RESULT, 0
+	Return
+
+; Pick an item from the Bag and how many.
+; In:  x8006 = quantity prompt (msg id)
+; Out: VAR_SPECIAL_RESULT = 1 if chosen (message box open), 0 if not (message box closed)
+_coop_pick_item:
+	FadeScreen 6, 1, 0, RGB_BLACK
+	WaitFade
+	CloseMsg
+	Coop COOP_SUB_CHOOSE_ITEM, 0, VAR_SPECIAL_RESULT
+	Coop COOP_SUB_GET_ITEM, 0, VAR_SPECIAL_RESULT
+	RestoreOverworld
+	FadeScreen 6, 1, 1, RGB_BLACK
+	WaitFade
+	Compare VAR_SPECIAL_RESULT, COOP_ITEM_NONE
+	GoToIfEq _coop_pick_item_none
+	Compare VAR_SPECIAL_RESULT, COOP_ITEM_NOT_SENDABLE
+	GoToIfEq _coop_pick_item_bad
+	NonNPCMsgVar VAR_SPECIAL_x8006
+	MenuInit 1, 1, 0, 1, VAR_SPECIAL_RESULT
+	MenuItemAdd msg_0040_00127, 255, 0
+	MenuItemAdd msg_0040_00128, 255, 1
+	MenuItemAdd msg_0040_00129, 255, 2
+	MenuItemAdd msg_0040_00130, 255, 3
+	MenuItemAdd msg_0040_00121, 255, 4
+	MenuExec
+	Compare VAR_SPECIAL_RESULT, 3
+	GoToIfGt _coop_pick_item_cancel
+	Coop COOP_SUB_SET_ITEM_QTY, VAR_SPECIAL_RESULT, VAR_SPECIAL_RESULT
+	Compare VAR_SPECIAL_RESULT, 0
+	GoToIfEq _coop_pick_item_bad
+	SetVar VAR_SPECIAL_RESULT, 1
+	Return
+
+_coop_pick_item_bad:
+	NonNPCMsg msg_0040_00151
+	WaitABPress
+_coop_pick_item_cancel:
+	CloseMsg
+_coop_pick_item_none:
+	SetVar VAR_SPECIAL_RESULT, 0
+	Return
+
+; Pick a Pokémon from the party to sell.
+; Out: VAR_SPECIAL_RESULT = COOP_MON_*. The message box is closed.
+_coop_pick_mon:
+	FadeScreen 6, 1, 0, RGB_BLACK
+	WaitFade
+	CloseMsg
+	PartySelectUI
+	GetPartySelection VAR_SPECIAL_x8007
+	RestoreOverworld
+	FadeScreen 6, 1, 1, RGB_BLACK
+	WaitFade
+	Coop COOP_SUB_SET_MON, VAR_SPECIAL_x8007, VAR_SPECIAL_RESULT
+	Compare VAR_SPECIAL_RESULT, COOP_MON_LAST
+	GoToIfEq _coop_pick_mon_last
+	Compare VAR_SPECIAL_RESULT, COOP_MON_MAIL
+	GoToIfEq _coop_pick_mon_mail
+	Return
+
+_coop_pick_mon_last:
+	NonNPCMsg msg_0040_00184
+	WaitABPress
+	CloseMsg
+	Return
+
+_coop_pick_mon_mail:
+	NonNPCMsg msg_0040_00185
+	WaitABPress
+	CloseMsg
+	Return
+
+; ---------------------------------------------------------------------------
+
+; std_coop_incoming: the partner sent us a request
+scr_seq_0003_073:
+	LockAll
+	; the answer may open menus (quantity list), see std_coop_menu
+	TouchscreenMenuHide
+	Coop COOP_SUB_INCOMING_INFO, 0, VAR_SPECIAL_x8004
+	Switch VAR_SPECIAL_x8004
+	Case COOP_REQ_BATTLE, _coop_in_battle
+	Case COOP_REQ_TRADE, _coop_in_trade
+	Case COOP_REQ_ITEM, _coop_in_item
+	Case COOP_REQ_MONEY, _coop_in_money
+	Case COOP_REQ_SELL_ITEM, _coop_in_sell_item
+	Case COOP_REQ_SELL_MON, _coop_in_sell_mon
+	Case COOP_REQ_BUY_ITEM, _coop_in_buy_item
+	Case COOP_REQ_BUY_MON, _coop_in_buy_mon
+	GoTo _coop_release
+
+_coop_in_battle:
+	NonNPCMsg msg_0040_00142
+	GoTo _coop_in_ask
+
+_coop_in_trade:
+	NonNPCMsg msg_0040_00143
+	GoTo _coop_in_ask
+
+_coop_in_item:
+	NonNPCMsg msg_0040_00144
+	GoTo _coop_in_ask
+
+_coop_in_money:
+	NonNPCMsg msg_0040_00145
+	GoTo _coop_in_ask
+
+_coop_in_sell_item:
+	NonNPCMsg msg_0040_00175
+	GoTo _coop_in_ask
+
+_coop_in_sell_mon:
+	NonNPCMsg msg_0040_00176
+_coop_in_ask:
+	YesNo VAR_SPECIAL_RESULT
+	Coop COOP_SUB_ANSWER, VAR_SPECIAL_RESULT, VAR_SPECIAL_RESULT
+	Switch VAR_SPECIAL_RESULT
+	Case COOP_RESULT_ACCEPT, _coop_in_accepted
+	Case COOP_RESULT_FULL, _coop_in_full
+	Case COOP_RESULT_POOR, _coop_not_enough
+	Case COOP_RESULT_CANCELLED, _coop_canceled
+	Case COOP_RESULT_NO_ANSWER, _coop_link_lost
+	GoTo _coop_close
+
+_coop_in_accepted:
+	Switch VAR_SPECIAL_x8004
+	Case COOP_REQ_ITEM, _coop_got_item
+	Case COOP_REQ_MONEY, _coop_got_money
+	Case COOP_REQ_SELL_ITEM, _coop_bought
+	Case COOP_REQ_SELL_MON, _coop_bought
+	GoTo _coop_activity
+
+_coop_got_item:
+	PlayFanfare SEQ_ME_ITEM
+	NonNPCMsg msg_0040_00148
+	WaitFanfare
+	WaitABPress
+	GoTo _coop_close
+
+_coop_got_money:
+	PlaySE SEQ_SE_DP_REGI
+	NonNPCMsg msg_0040_00149
+	WaitABPress
+	GoTo _coop_close
+
+_coop_in_full:
+	Compare VAR_SPECIAL_x8004, COOP_REQ_MONEY
+	GoToIfEq _coop_in_wallet_full
+	Compare VAR_SPECIAL_x8004, COOP_REQ_SELL_MON
+	GoToIfEq _coop_in_party_full
+	NonNPCMsg msg_0040_00152
+	WaitABPress
+	GoTo _coop_close
+
+_coop_in_party_full:
+	NonNPCMsg msg_0040_00186
+	WaitABPress
+	GoTo _coop_close
+
+_coop_in_wallet_full:
+	NonNPCMsg msg_0040_00153
+	WaitABPress
+	GoTo _coop_close
+
+; The partner wants to buy something from us: pick what to offer.
+_coop_in_buy_item:
+	NonNPCMsg msg_0040_00177
+	YesNo VAR_SPECIAL_RESULT
+	Compare VAR_SPECIAL_RESULT, 0
+	GoToIfNe _coop_in_refuse
+	SetVar VAR_SPECIAL_x8006, msg_0040_00172
+	Call _coop_pick_item
+	Compare VAR_SPECIAL_RESULT, 0
+	GoToIfEq _coop_in_refuse_closed
+	SetVar VAR_SPECIAL_x8007, COOP_DEAL_ITEM
+	GoTo _coop_in_offer
+
+_coop_in_buy_mon:
+	NonNPCMsg msg_0040_00178
+	YesNo VAR_SPECIAL_RESULT
+	Compare VAR_SPECIAL_RESULT, 0
+	GoToIfNe _coop_in_refuse
+	Call _coop_pick_mon
+	Compare VAR_SPECIAL_RESULT, COOP_MON_OK
+	GoToIfNe _coop_in_refuse_closed
+	SetVar VAR_SPECIAL_x8007, COOP_DEAL_MON
+_coop_in_offer:
+	NonNPCMsg msg_0040_00157
+	Coop COOP_SUB_SEND_OFFER, VAR_SPECIAL_x8007, VAR_SPECIAL_RESULT
+	Switch VAR_SPECIAL_RESULT
+	Case COOP_RESULT_ACCEPT, _coop_in_sold
+	Case COOP_RESULT_DECLINE, _coop_declined
+	Case COOP_RESULT_CANCELLED, _coop_canceled
+	GoTo _coop_link_lost
+
+_coop_in_sold:
+	Compare VAR_SPECIAL_x8007, COOP_DEAL_MON
+	GoToIfEq _coop_sold_mon
+	GoTo _coop_sold_item
+
+_coop_in_refuse:
+	Coop COOP_SUB_ANSWER, 1, VAR_SPECIAL_RESULT
+	GoTo _coop_close
+
+_coop_in_refuse_closed:
+	Coop COOP_SUB_ANSWER, 1, VAR_SPECIAL_RESULT
+	GoTo _coop_release
 	.balign 4, 0
