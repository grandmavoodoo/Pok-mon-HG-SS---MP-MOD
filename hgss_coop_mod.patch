diff --git a/Makefile b/Makefile
index bc96194..a2b9ec0 100644
--- a/Makefile
+++ b/Makefile
@@ -83,6 +83,16 @@ $(HEADER_TEMPLATE): ;
 $(ROM): $(ROMSPEC) filesystem main_lz sub $(BANNER)
 	$(WINE) $(MAKEROM) $(MAKEROM_FLAGS) -DBUILD_DIR=$(BUILD_DIR) -DNITROFS_FILES="$(NITROFS_FILES:files/%=%)" -DTITLE_NAME="$(TITLE_NAME)" -DBNR="$(BANNER)" -DHEADER_TEMPLATE="$(HEADER_TEMPLATE)" $< $@
 	$(FIXROM) $@ --secure-crc $(SECURE_CRC) --game-code $(GAME_CODE)
+# Co-op mod: nds-bootstrap patches the SDK by its retail addresses (see the end
+# of "Static main" in main.lsf). Refuse to produce a ROM where it moved.
+	@grep -Eq '^ +020D2894 [0-9A-F]{8} \.text +DC_FlushRange\b' $(XMAP) && \
+	 grep -Eq '^ +020D8B6C [0-9A-F]{8} \.text +FS_StartOverlay\b' $(XMAP) || \
+	 { echo "error: NitroSDK code moved from its retail address (DC_FlushRange must be at 020D2894, FS_StartOverlay at 020D8B6C in $(XMAP)); nds-bootstrap would crash this ROM. See main.lsf." >&2; $(RM) $@; exit 1; }
+# Co-op mod: Action Replay cheats (usrcheat.dat) use retail RAM addresses, so
+# static data, the overlays and the heaps must stay where retail has them.
+	@$(PYTHON) $(TOOLSDIR)/usrcheat_crc/check_layout.py $(XMAP) $(firstword $(subst ., ,$(buildname))) || { $(RM) $@; exit 1; }
+# Match the retail usrcheat.dat key, so TWiLight Menu++ / Pico Launcher find the cheats.
+	$(PYTHON) $(TOOLSDIR)/usrcheat_crc/usrcheat_crc.py $@ $(USRCHEAT_KEY)
 ifeq ($(COMPARE),1)
 	$(SHA1SUM) -c $(buildname)/rom.sha1
 endif
