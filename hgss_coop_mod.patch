diff --git a/asm/macros/script.inc b/asm/macros/script.inc
index c119881..a81eb1f 100644
--- a/asm/macros/script.inc
+++ b/asm/macros/script.inc
@@ -4783,6 +4783,16 @@
 	.byte \arg1
 	.endm
 
+	; Co-op mod: sub = COOP_SUB_*, arg = value or var, retvar = result var.
+	; Uses command 486 (retail Dummy486, which no script uses), so the command
+	; table keeps its retail size and the static data stays at retail addresses.
+	.macro Coop sub, arg, retvar
+	.short 486
+	.short \sub
+	.short \arg
+	.short \retvar
+	.endm
+
 	; Script headers
 
 	.macro MapScript kind, script
