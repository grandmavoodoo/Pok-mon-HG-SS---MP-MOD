+// -------------------------------------------------------------------------
+// Script command: Coop <sub>, <arg>, <retvar>
+// ctx->data[0] = retvar id, data[1] = frame counter for the native waits.
+// -------------------------------------------------------------------------
+
+static u16 *Coop_RetVar(ScriptContext *ctx) {
