+#!/usr/bin/env python3
+"""Make a ROM's header match a usrcheat.dat entry (co-op mod).
+
+TWiLight Menu++, Pico Launcher, Wood/AKAIO and other R4-style loaders find a
+game's cheats in usrcheat.dat by game code + a CRC32 of the first 512 bytes of
+the ROM header (crc = ~0, reflected poly 0xEDB88320, no final XOR, i.e.
+~zlib.crc32). Any change to the ARM9 size, file table offsets etc. changes
+that CRC, so a modded ROM never finds the retail game's cheats.
+
+This sets the reserved header word at 0x16C ("transferred and stored, but not
+used"; outside the header CRC16 at 0x15E, which covers 0x000-0x15D) so that
+the key equals the retail one. The cheats themselves only work because the
+mod keeps retail HGSS's memory layout (see main.lsf / src/coop.c).
+
+On an unmodified build the solved word is 0, so the ROM is left unchanged.
+
+usage: usrcheat_crc.py ROM KEY     e.g. usrcheat_crc.py pokeheartgold.us.nds 0x4DFFBF91
+"""
+
+import sys
+
+FORGE_OFFSET = 0x16C
+HEADER_SIZE = 0x200
+
+TABLE = []
+for i in range(256):
+    c = i
+    for _ in range(8):
+        c = (c >> 1) ^ (0xEDB88320 if c & 1 else 0)
+    TABLE.append(c)
+TOP_BYTE_TO_INDEX = {TABLE[i] >> 24: i for i in range(256)}
+
+
+def crc_forward(state, data):
+    for b in data:
+        state = (state >> 8) ^ TABLE[(state ^ b) & 0xFF]
+    return state
+
+
+def crc_backward(state, data):
+    # Undo crc_forward: the top byte of each TABLE entry is unique.
+    for b in reversed(data):
+        i = TOP_BYTE_TO_INDEX[state >> 24]
+        state = (((state ^ TABLE[i]) << 8) & 0xFFFFFFFF) | (i ^ b)
+    return state
+
+
+def usrcheat_key(header):
+    return crc_forward(0xFFFFFFFF, header[:HEADER_SIZE])
+
+
+def main():
+    if len(sys.argv) != 3:
+        sys.exit(__doc__)
+    path, key = sys.argv[1], int(sys.argv[2], 0)
+    with open(path, 'r+b') as f:
+        header = bytearray(f.read(HEADER_SIZE))
+        if len(header) != HEADER_SIZE:
+            sys.exit(f'{path}: too short for an NDS header')
+        before = usrcheat_key(header)
+        # State needed right after the 4 forged bytes, then solve for them:
+        # feeding 4 bytes w from state s gives the same result as feeding 4
+        # zero bytes from state s ^ w.
+        state_before = crc_forward(0xFFFFFFFF, header[:FORGE_OFFSET])
+        state_after = crc_backward(key, header[FORGE_OFFSET + 4:])
+        word = crc_backward(state_after, bytes(4)) ^ state_before
+        header[FORGE_OFFSET:FORGE_OFFSET + 4] = word.to_bytes(4, 'little')
+        after = usrcheat_key(header)
+        if after != key:
+            sys.exit(f'{path}: internal error, got key {after:08X}, wanted {key:08X}')
+        f.seek(FORGE_OFFSET)
+        f.write(header[FORGE_OFFSET:FORGE_OFFSET + 4])
+    game_code = header[0xC:0x10].decode('ascii', 'replace')
+    print(f'{path}: usrcheat.dat key {game_code}-{before:08X} -> {game_code}-{after:08X} (header 0x{FORGE_OFFSET:X} = {word:08X})')
+
+
+if __name__ == '__main__':
+    main()
